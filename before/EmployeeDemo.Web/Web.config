<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Change "Server=" to your SQL Server instance, e.g. localhost, .\SQLEXPRESS -->
  <connectionStrings>
    <add name="EmployeeDemo"
         connectionString="Server=.\SQLSERVER_RKS;Database=EmployeeDemo;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />

    <!-- Login cookie. HttpOnly by default (JavaScript can't read it).
         SameSite=Lax stops other sites from posting to our API with the user's cookie (CSRF).
         Set requireSSL="true" when the site runs on HTTPS. -->
    <authentication mode="Forms">
      <forms name=".EmployeeDemoAuth" loginUrl="index.html#!/login" timeout="60"
             slidingExpiration="true" cookieSameSite="Lax" />
    </authentication>
  </system.web>

  <system.webServer>
    <!-- Opening http://localhost:52100/ serves the AngularJS app -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <!-- Runs for every request, static files included: sends direct visits to /app/*.html back to the app -->
    <modules>
      <add name="TemplateRedirectModule" type="EmployeeDemo.Web.Modules.TemplateRedirectModule" />
    </modules>
    <!-- Lets Web API handle extensionless URLs such as /api/employees/5 for every verb (GET, POST, PUT, DELETE) -->
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*"
           type="System.Web.Handlers.TransferRequestHandler"
           preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>

  <runtime>
    <!-- Web API 5.2.9 was compiled against an older Newtonsoft.Json; redirect it to 13.0.0.0 -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
